{
  "name": "checkprint",
  "version": "1.0.0",
  "private": true,
  "description": "Offline-first bank cheque printing desktop application",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "lint": "node --check src/main.cjs && node --check src/preload.cjs && node --check src/core/validation.cjs && node --check src/core/store.cjs && node --check src/core/words.cjs && node --check src/core/cheque.cjs && node --check src/core/printlog.cjs && node --check scripts/require-signing.cjs",
    "build:win": "electron-builder --win nsis --x64 --publish never",
    "build:win:signed": "node scripts/require-signing.cjs && electron-builder --win nsis --x64 --publish never",
    "build:dir": "electron-builder --win dir --x64"
  },
  "dependencies": {"xlsx": "^0.18.5"},
  "devDependencies": {"electron": "^33.4.11", "electron-builder": "^25.1.8"},
  "build": {
    "appId": "com.checkprint.desktop",
    "productName": "CheckPrint",
    "asar": true,
    "directories": {"output": "dist"},
    "files": ["src/**/*", "index.html", "package.json", "node_modules/xlsx/**/*"],
    "win": {"target": [{"target":"nsis", "arch":["x64"]}], "artifactName":"CheckPrint-${version}-Setup-${arch}.${ext}"},
    "nsis": {"oneClick": false, "allowToChangeInstallationDirectory": true}
  },
  "engines": {"node": ">=20"}
}
