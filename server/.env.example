DB_PASSWORD=change-me-long-random
# Paste the content of licence-private.pem with real line breaks replaced by \n
LICENSE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# Used only the first time, to create the admin login. Remove ADMIN_PASSWORD afterwards.
ADMIN_EMAIL=you@yourcompany.com
ADMIN_PASSWORD=at-least-12-characters
# Where customers send money (shown in the app)
PAY_BKASH=01XXXXXXXXX (Personal)
PAY_NAGAD=01XXXXXXXXX (Personal)
PAY_BANK=Bank name, branch, account name, number
SUPPORT_CONTACT=01XXXXXXXXX / support@yourcompany.com
